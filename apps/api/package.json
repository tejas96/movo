{
  "name": "@movo/api",
  "version": "0.0.1",
  "private": true,
  "description": "MOVO backend. NestJS, PostgreSQL, Prisma.",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "seed": "nest build && node dist/cli/seed.js",
    "files": "nest build && node dist/cli/files.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@movo/contracts": "workspace:*",
    "@movo/i18n": "workspace:*",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "jose": "6.2.12",
    "nestjs-pino": "5.2.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuidv7": "1.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@movo/config": "workspace:*",
    "@nestjs/cli": "12.0.7",
    "@swc/core": "1.16.2",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  }
}
