NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://movo:movo@localhost:5433/movo
# at least 32 characters; generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-32-plus-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# deep link base used in password reset emails
APP_BASE_URL=movo://
# optional: Resend for reset emails. Empty = log the link instead of sending.
RESEND_API_KEY=
EMAIL_FROM=MOVO <no-reply@example.com>
# optional: the first platform admin, created by `pnpm seed`
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me-please
# optional: Firebase service account JSON (one line). Empty = push is logged, not sent.
FIREBASE_SERVICE_ACCOUNT_JSON=
LOG_LEVEL=info
MIN_SUPPORTED_APP_VERSION=0.1.0
LATEST_APP_VERSION=0.1.0
SUPPORT_EMAIL=
PRIVACY_POLICY_URL=
# Photos. "disk" keeps them in FILES_DIR. "s3" uses a bucket: locally the rustfs container
# heliogrid-object-store-local (make the bucket once: pnpm --filter @movo/api files bucket).
STORAGE_DRIVER=disk
FILES_DIR=./data/files
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_BUCKET=movo-local
# S3_ACCESS_KEY_ID=heliogrid
# S3_SECRET_ACCESS_KEY=heliogrid-local-secret
# healthchecks.io ping URL; the API pings it every 5 minutes. Empty = off.
UPTIME_HEARTBEAT_URL=
