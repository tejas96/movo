generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- enums ----------
enum UserStatus {
  ACTIVE
  DELETED
}

enum CredentialType {
  PASSWORD
  OTP_PHONE
  GOOGLE
  APPLE
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum ResetKind {
  EMAIL_LINK
  ADMIN_CODE
}

enum Locale {
  en
  hi
  mr
}

enum SocietyStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  INVITED
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  LEFT
}

enum OccupancyRelation {
  OWNER
  TENANT
  FAMILY
  OTHER
}

enum FlatStatus {
  OCCUPIED
  VACANT
  INACTIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NoticeCategory {
  GENERAL
  WATER
  ELECTRICITY
  MAINTENANCE
  SECURITY
  EVENT
  FINANCE
  EMERGENCY
  OTHER
}

enum NoticePriority {
  NORMAL
  IMPORTANT
  EMERGENCY
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationCategory {
  NOTICE
  MEETING
  EVENT
  TASK
  DUTY
  MAINTENANCE
  EXPENSE
  EMERGENCY
  MARKETPLACE
  MEMBERSHIP
  SYSTEM
}

enum DeliveryChannel {
  PUSH
  EMAIL
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum ParkingSlotType {
  TWO_WHEELER
  FOUR_WHEELER
  EV
  OTHER
}

enum ParkingSlotStatus {
  ACTIVE
  BLOCKED
  VISITOR
}

enum VehicleType {
  TWO_WHEELER
  FOUR_WHEELER
  EV
  OTHER
}

enum VendorStatus {
  SUGGESTED
  APPROVED
  TRIAL
  BLOCKED
}

enum EmergencyContactType {
  MEDICAL
  FIRE
  POLICE
  SECURITY
  LIFT
  ADMIN
  OTHER
}

enum AlertSource {
  USER
  DEVICE
}

enum AlertType {
  MEDICAL
  FIRE
  SECURITY
  LIFT
  GAS
  OTHER
}

enum AlertStatus {
  ACTIVE
  RESOLVED
  FALSE_ALARM
}

// ---------- identity (global) ----------
enum MeetingStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum MeetingUpdateKind {
  RESCHEDULED
  NOTE
  CANCELLED
  COMPLETED
}

enum EventStatus {
  PUBLISHED
  CANCELLED
}

enum RsvpResponse {
  GOING
  MAYBE
  NOT_GOING
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum AmountRule {
  FLAT_RATE
  PER_SQFT
}

enum BillKind {
  MAINTENANCE
  ADHOC
}

enum BillStatus {
  DUE
  PARTIALLY_PAID
  OVERDUE
  PAID
  WAIVED
}

enum BillLineType {
  BASE
  LATE_FEE
}

enum PaymentMethod {
  UPI
  CASH
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum PaymentStatus {
  RECORDED
  REVERSED
}

enum PaymentInstructionKind {
  UPI
  BANK
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IncomeKind {
  DONATION
  INTEREST
  HALL_BOOKING
  PENALTY
  OTHER
}

enum DutyPeriodUnit {
  DAY
  WEEK
  MONTH
}

enum DutyParticipantKind {
  FLAT
  MEMBER
}

enum DutyStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum DutyOnMiss {
  MARK_MISSED
  CARRY_OVER
}

enum AssignmentStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  MISSED
  SKIPPED
}

enum FileKind {
  LISTING_IMAGE
  AVATAR
  SOCIETY_LOGO
  EXPENSE_RECEIPT
  PAYMENT_PROOF
  TASK_PROOF
}

enum ListingKind {
  FOOD
  PRODUCT
  SERVICE
  RESALE
}

enum Diet {
  VEG
  EGG
  NON_VEG
}

enum PriceType {
  FIXED
  PER_UNIT
  NEGOTIABLE
  FREE
}

enum Fulfilment {
  PICKUP
  DELIVERY
  BOTH
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ListingStatus {
  ACTIVE
  PAUSED
  ARCHIVED
  HIDDEN
}

enum ListingVisibility {
  SOCIETY
  NETWORK
}

enum OrderStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  READY
  COMPLETED
  CANCELLED
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  CANCELLED
}

enum TaskEventKind {
  CREATED
  ASSIGNED
  VOLUNTEERED
  WITHDRAWN
  SUBMITTED
  RETURNED
  VERIFIED
  CANCELLED
}

enum PointsReason {
  TASK
  DUTY
  ADJUSTMENT
}

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  email            String?    @unique
  phone            String?    @unique
  displayName      String
  locale           Locale     @default(en)
  /// Profile photo. A StoredFile with no society.
  avatarFileId     String?    @unique @db.Uuid
  status           UserStatus @default(ACTIVE)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  credentials   UserCredential[]
  sessions      RefreshSession[]
  devices       DeviceToken[]
  resets        PasswordReset[]
  memberships   Membership[]
  joinRequests  JoinRequest[]
  notifications Notification[]
  platformAdmin PlatformAdmin?
  preferences   NotificationPreference[]
  avatar        StoredFile?              @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
}

model UserCredential {
  id              String         @id @default(uuid(7)) @db.Uuid
  userId          String         @db.Uuid
  type            CredentialType
  secretHash      String?
  providerSubject String?
  verifiedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model RefreshSession {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  deviceName   String?
  platform     String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  lastUsedAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model DeviceToken {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  appVersion String?
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @db.Uuid
  codeHash       String
  kind           ResetKind
  issuedByUserId String?   @db.Uuid
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PlatformAdmin {
  userId    String   @id @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- tenancy ----------
model Society {
  id            String        @id @default(uuid(7)) @db.Uuid
  name          String
  slug          String        @unique
  logoFileId    String?       @unique @db.Uuid
  addressLine   String?
  city          String?
  state         String?
  pincode       String?
  timezone      String        @default("Asia/Kolkata")
  defaultLocale Locale        @default(en)
  currency      String        @default("INR")
  fyStartMonth  Int           @default(4)
  joinCode      String?       @unique
  settings      Json          @default("{}")
  status        SocietyStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  buildings    Building[]
  flats        Flat[]
  memberships  Membership[]
  roles        Role[]
  invitations  Invitation[]
  joinRequests JoinRequest[]
  modules      SocietyModule[]
  notices      Notice[]
  occupancies  FlatOccupancy[]

  parkingSlots               ParkingSlot[]
  parkingAllocations         ParkingAllocation[]
  vehicles                   Vehicle[]
  vendorCategories           VendorCategory[]
  vendors                    Vendor[]
  emergencyContacts          EmergencyContact[]
  alerts                     Alert[]
  meetings                   Meeting[]
  meetingUpdates             MeetingUpdate[]
  events                     SocietyEvent[]
  eventRsvps                 EventRsvp[]
  remindersSent              ReminderSent[]
  billingPlans               BillingPlan[]
  chargeOverrides            FlatChargeOverride[]
  bills                      Bill[]
  billLines                  BillLine[]
  payments                   Payment[]
  allocations                PaymentAllocation[]
  receiptCounters            ReceiptCounter[]
  paymentInstructions        PaymentInstruction[]
  expenseCategories          ExpenseCategory[]
  expenses                   Expense[]
  incomeEntries              IncomeEntry[]
  responsibilities           Responsibility[]
  responsibilityParticipants ResponsibilityParticipant[]
  responsibilityAssignments  ResponsibilityAssignment[]
  tasks                      Task[]
  taskEvents                 TaskEvent[]
  pointsLedgers              PointsLedger[]
  files                      StoredFile[]
  logo                       StoredFile?                 @relation("SocietyLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  listings                   Listing[]
  listingImages              ListingImage[]
  marketOrders               MarketOrder[]
  orderMessages              OrderMessage[]
  listingReviews             ListingReview[]
  listingReports             ListingReport[]
}

model Building {
  id          String   @id @default(uuid(7)) @db.Uuid
  societyId   String   @db.Uuid
  name        String
  floorsCount Int?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flats   Flat[]

  @@unique([societyId, name])
}

model Flat {
  id         String     @id @default(uuid(7)) @db.Uuid
  societyId  String     @db.Uuid
  buildingId String?    @db.Uuid
  number     String
  floor      Int?
  type       String?
  areaSqft   Int?
  status     FlatStatus @default(VACANT)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  society      Society              @relation(fields: [societyId], references: [id], onDelete: Cascade)
  building     Building?            @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  occupancies  FlatOccupancy[]
  invitations  Invitation[]
  joinRequests JoinRequest[]
  allocations  ParkingAllocation[]
  vehicles     Vehicle[]
  alerts       Alert[]
  overrides    FlatChargeOverride[]
  bills        Bill[]
  payments     Payment[]

  @@unique([societyId, buildingId, number])
  @@index([societyId])
}

model Membership {
  id               String           @id @default(uuid(7)) @db.Uuid
  societyId        String           @db.Uuid
  userId           String           @db.Uuid
  status           MembershipStatus @default(ACTIVE)
  joinedAt         DateTime?
  leftAt           DateTime?
  privacyShowPhone Boolean          @default(false)
  privacyShowEmail Boolean          @default(false)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  society     Society          @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles       MembershipRole[]
  occupancies FlatOccupancy[]
  noticeReads NoticeRead[]
  eventRsvps  EventRsvp[]

  @@unique([societyId, userId])
  @@index([userId, status])
  @@index([societyId, status])
}

model Role {
  id        String   @id @default(uuid(7)) @db.Uuid
  societyId String   @db.Uuid
  key       String
  name      String
  isSystem  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society     Society          @relation(fields: [societyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  members     MembershipRole[]
  invitations Invitation[]

  @@unique([societyId, key])
}

model RolePermission {
  roleId        String @db.Uuid
  permissionKey String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
}

model MembershipRole {
  membershipId String @db.Uuid
  roleId       String @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
}

model FlatOccupancy {
  id               String            @id @default(uuid(7)) @db.Uuid
  societyId        String            @db.Uuid
  flatId           String            @db.Uuid
  membershipId     String            @db.Uuid
  relation         OccupancyRelation
  isPrimaryContact Boolean           @default(false)
  fromDate         DateTime          @default(now())
  toDate           DateTime?
  createdAt        DateTime          @default(now())

  society    Society    @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flat       Flat       @relation(fields: [flatId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([flatId])
  @@index([membershipId])
}

model Invitation {
  id                    String            @id @default(uuid(7)) @db.Uuid
  societyId             String            @db.Uuid
  code                  String            @unique
  inviteeName           String
  email                 String?
  phone                 String?
  flatId                String?           @db.Uuid
  roleId                String            @db.Uuid
  relation              OccupancyRelation @default(OWNER)
  invitedByMembershipId String            @db.Uuid
  expiresAt             DateTime
  status                InvitationStatus  @default(PENDING)
  acceptedMembershipId  String?           @db.Uuid
  acceptedAt            DateTime?
  createdAt             DateTime          @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flat    Flat?   @relation(fields: [flatId], references: [id], onDelete: SetNull)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([societyId, status])
  @@index([phone])
  @@index([email])
}

model JoinRequest {
  id                    String            @id @default(uuid(7)) @db.Uuid
  societyId             String            @db.Uuid
  userId                String            @db.Uuid
  flatId                String            @db.Uuid
  relationClaimed       OccupancyRelation
  message               String?
  status                JoinRequestStatus @default(PENDING)
  decidedByMembershipId String?           @db.Uuid
  decidedAt             DateTime?
  decisionReason        String?
  createdAt             DateTime          @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  flat    Flat    @relation(fields: [flatId], references: [id], onDelete: Cascade)

  @@index([societyId, status])
  @@index([userId, status])
}

model SocietyModule {
  societyId       String   @db.Uuid
  moduleKey       String
  enabled         Boolean  @default(true)
  settings        Json     @default("{}")
  settingsVersion Int      @default(1)
  updatedAt       DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@id([societyId, moduleKey])
}

// ---------- notices ----------
model Notice {
  id                    String         @id @default(uuid(7)) @db.Uuid
  societyId             String         @db.Uuid
  title                 String
  body                  String
  category              NoticeCategory @default(GENERAL)
  priority              NoticePriority @default(NORMAL)
  isPinned              Boolean        @default(false)
  audience              Json
  status                NoticeStatus   @default(DRAFT)
  publishedAt           DateTime?
  expiresAt             DateTime?
  createdByMembershipId String         @db.Uuid
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  society Society      @relation(fields: [societyId], references: [id], onDelete: Cascade)
  reads   NoticeRead[]

  @@index([societyId, status, isPinned, publishedAt])
}

model NoticeRead {
  noticeId     String   @db.Uuid
  membershipId String   @db.Uuid
  readAt       DateTime @default(now())

  notice     Notice     @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([noticeId, membershipId])
}

// ---------- parking ----------
model ParkingSlot {
  id        String            @id @default(uuid(7)) @db.Uuid
  societyId String            @db.Uuid
  code      String
  type      ParkingSlotType   @default(FOUR_WHEELER)
  level     String?
  status    ParkingSlotStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  society     Society             @relation(fields: [societyId], references: [id], onDelete: Cascade)
  allocations ParkingAllocation[]

  @@unique([societyId, code])
}

/// One active allocation per slot (toDate null), enforced by a partial unique index in the migration.
model ParkingAllocation {
  id                      String    @id @default(uuid(7)) @db.Uuid
  societyId               String    @db.Uuid
  slotId                  String    @db.Uuid
  flatId                  String    @db.Uuid
  fromDate                DateTime  @default(now())
  toDate                  DateTime?
  notes                   String?
  allocatedByMembershipId String    @db.Uuid
  createdAt               DateTime  @default(now())

  society Society     @relation(fields: [societyId], references: [id], onDelete: Cascade)
  slot    ParkingSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  flat    Flat        @relation(fields: [flatId], references: [id], onDelete: Cascade)

  @@index([societyId, flatId])
  @@index([slotId])
}

model Vehicle {
  id             String      @id @default(uuid(7)) @db.Uuid
  societyId      String      @db.Uuid
  flatId         String      @db.Uuid
  registrationNo String
  type           VehicleType @default(FOUR_WHEELER)
  makeModel      String?
  color          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flat    Flat    @relation(fields: [flatId], references: [id], onDelete: Cascade)

  @@unique([societyId, registrationNo])
  @@index([societyId, flatId])
}

// ---------- services (vendors) ----------
model VendorCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  societyId String   @db.Uuid
  key       String?
  name      String
  icon      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  vendors Vendor[]

  @@unique([societyId, name])
}

model Vendor {
  id                  String       @id @default(uuid(7)) @db.Uuid
  societyId           String       @db.Uuid
  categoryId          String       @db.Uuid
  name                String
  phone               String
  altPhone            String?
  description         String?
  availability        String?
  status              VendorStatus @default(APPROVED)
  adminNotes          String?
  addedByMembershipId String       @db.Uuid
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  society  Society        @relation(fields: [societyId], references: [id], onDelete: Cascade)
  category VendorCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([societyId, categoryId, status])
}

// ---------- emergency ----------
model EmergencyContact {
  id             String               @id @default(uuid(7)) @db.Uuid
  societyId      String               @db.Uuid
  label          String
  phone          String
  type           EmergencyContactType @default(OTHER)
  sortOrder      Int                  @default(0)
  isPublicNumber Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@index([societyId, sortOrder])
}

model Alert {
  id                     String      @id @default(uuid(7)) @db.Uuid
  societyId              String      @db.Uuid
  source                 AlertSource @default(USER)
  type                   AlertType
  raisedByMembershipId   String?     @db.Uuid
  flatId                 String?     @db.Uuid
  message                String?
  status                 AlertStatus @default(ACTIVE)
  resolvedByMembershipId String?     @db.Uuid
  resolvedAt             DateTime?
  resolutionNote         String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flat    Flat?   @relation(fields: [flatId], references: [id], onDelete: SetNull)

  @@index([societyId, status, createdAt(sort: Desc)])
  @@index([raisedByMembershipId, createdAt])
}

// ---------- meetings and events ----------
model Meeting {
  id                    String        @id @default(uuid(7)) @db.Uuid
  societyId             String        @db.Uuid
  title                 String
  agenda                String?
  location              String?
  startsAt              DateTime
  endsAt                DateTime?
  audience              Json
  status                MeetingStatus @default(SCHEDULED)
  createdByMembershipId String        @db.Uuid
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  society Society         @relation(fields: [societyId], references: [id], onDelete: Cascade)
  updates MeetingUpdate[]

  @@index([societyId, startsAt])
  @@index([status, startsAt])
}

model MeetingUpdate {
  id                    String            @id @default(uuid(7)) @db.Uuid
  societyId             String            @db.Uuid
  meetingId             String            @db.Uuid
  kind                  MeetingUpdateKind
  body                  String?
  previousStartsAt      DateTime?
  createdByMembershipId String            @db.Uuid
  createdAt             DateTime          @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt(sort: Desc)])
}

/// "Event" would shadow the DOM type in TypeScript, so the model is SocietyEvent.
model SocietyEvent {
  id                    String      @id @default(uuid(7)) @db.Uuid
  societyId             String      @db.Uuid
  title                 String
  description           String?
  location              String?
  startsAt              DateTime
  endsAt                DateTime?
  rsvpEnabled           Boolean     @default(true)
  audience              Json
  status                EventStatus @default(PUBLISHED)
  createdByMembershipId String      @db.Uuid
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  society Society     @relation(fields: [societyId], references: [id], onDelete: Cascade)
  rsvps   EventRsvp[]

  @@index([societyId, startsAt])
  @@index([status, startsAt])
}

model EventRsvp {
  eventId      String       @db.Uuid
  membershipId String       @db.Uuid
  societyId    String       @db.Uuid
  response     RsvpResponse
  guestsCount  Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  society    Society      @relation(fields: [societyId], references: [id], onDelete: Cascade)
  event      SocietyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  membership Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([eventId, membershipId])
}

/// One row per reminder sent, so a job restart never sends it twice.
model ReminderSent {
  id         String   @id @default(uuid(7)) @db.Uuid
  societyId  String   @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  kind       String
  sentAt     DateTime @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId, kind])
}

// ---------- money: maintenance ----------
model BillingPlan {
  id                 String           @id @default(uuid(7)) @db.Uuid
  societyId          String           @db.Uuid
  name               String
  frequency          BillingFrequency
  amountRule         AmountRule
  amountPaise        Int
  dueDay             Int
  generateDaysBefore Int
  lateFee            Json
  activeFrom         DateTime         @db.Date
  activeTo           DateTime?        @db.Date
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  society   Society              @relation(fields: [societyId], references: [id], onDelete: Cascade)
  overrides FlatChargeOverride[]
  bills     Bill[]

  @@index([societyId, isActive])
}

model FlatChargeOverride {
  planId      String @db.Uuid
  flatId      String @db.Uuid
  societyId   String @db.Uuid
  amountPaise Int

  society Society     @relation(fields: [societyId], references: [id], onDelete: Cascade)
  plan    BillingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  flat    Flat        @relation(fields: [flatId], references: [id], onDelete: Cascade)

  @@id([planId, flatId])
}

model Bill {
  id            String     @id @default(uuid(7)) @db.Uuid
  societyId     String     @db.Uuid
  flatId        String     @db.Uuid
  planId        String?    @db.Uuid
  kind          BillKind
  title         String
  periodKey     String?
  dueDate       DateTime   @db.Date
  financialYear String
  totalPaise    Int
  paidPaise     Int        @default(0)
  status        BillStatus @default(DUE)
  lateFeeWaived Boolean    @default(false)
  waivedReason  String?
  waivedAt      DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  society     Society             @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flat        Flat                @relation(fields: [flatId], references: [id], onDelete: Cascade)
  plan        BillingPlan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  lines       BillLine[]
  allocations PaymentAllocation[]

  @@unique([planId, flatId, periodKey])
  @@index([societyId, flatId, status])
  @@index([societyId, status, dueDate])
}

model BillLine {
  id          String       @id @default(uuid(7)) @db.Uuid
  societyId   String       @db.Uuid
  billId      String       @db.Uuid
  type        BillLineType
  label       String
  amountPaise Int

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  bill    Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([billId, type])
}

model Payment {
  id                     String        @id @default(uuid(7)) @db.Uuid
  societyId              String        @db.Uuid
  flatId                 String        @db.Uuid
  amountPaise            Int
  paidOn                 DateTime      @db.Date
  method                 PaymentMethod
  reference              String?
  receiptNo              String
  notes                  String?
  financialYear          String
  recordedByMembershipId String        @db.Uuid
  status                 PaymentStatus @default(RECORDED)
  reversedReason         String?
  reversedAt             DateTime?
  idempotencyKey         String
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  society     Society             @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flat        Flat                @relation(fields: [flatId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]
  proofs      StoredFile[]

  @@unique([societyId, receiptNo])
  @@unique([societyId, idempotencyKey])
  @@index([societyId, flatId, paidOn(sort: Desc)])
}

model PaymentAllocation {
  id          String   @id @default(uuid(7)) @db.Uuid
  societyId   String   @db.Uuid
  paymentId   String   @db.Uuid
  billId      String   @db.Uuid
  amountPaise Int
  createdAt   DateTime @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill    Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([billId])
}

/// Next receipt number per society and financial year.
model ReceiptCounter {
  societyId     String @db.Uuid
  financialYear String
  lastNo        Int    @default(0)

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@id([societyId, financialYear])
}

model PaymentInstruction {
  id        String                 @id @default(uuid(7)) @db.Uuid
  societyId String                 @db.Uuid
  kind      PaymentInstructionKind
  label     String
  value     String
  payeeName String?
  isActive  Boolean                @default(true)
  sortOrder Int                    @default(0)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@index([societyId, sortOrder])
}

// ---------- money: expenses ----------
model ExpenseCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  societyId String   @db.Uuid
  key       String?
  name      String
  icon      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society  Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([societyId, name])
}

model Expense {
  id                    String        @id @default(uuid(7)) @db.Uuid
  societyId             String        @db.Uuid
  categoryId            String        @db.Uuid
  amountPaise           Int
  incurredOn            DateTime      @db.Date
  payeeName             String
  description           String?
  method                PaymentMethod
  reference             String?
  status                ExpenseStatus
  financialYear         String
  createdByMembershipId String        @db.Uuid
  decidedByMembershipId String?       @db.Uuid
  decidedAt             DateTime?
  rejectionReason       String?
  idempotencyKey        String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  society  Society         @relation(fields: [societyId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  receipts StoredFile[]

  @@unique([societyId, idempotencyKey])
  @@index([societyId, financialYear, status])
  @@index([societyId, incurredOn(sort: Desc)])
}

model IncomeEntry {
  id                    String     @id @default(uuid(7)) @db.Uuid
  societyId             String     @db.Uuid
  kind                  IncomeKind
  amountPaise           Int
  receivedOn            DateTime   @db.Date
  description           String?
  financialYear         String
  createdByMembershipId String     @db.Uuid
  createdAt             DateTime   @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@index([societyId, financialYear])
}

// ---------- duties, tasks, rewards ----------
/// A rotating duty ("Duties" in the app).
model Responsibility {
  id                    String              @id @default(uuid(7)) @db.Uuid
  societyId             String              @db.Uuid
  title                 String
  description           String?
  participantKind       DutyParticipantKind
  periodUnit            DutyPeriodUnit
  periodLength          Int
  startDate             DateTime            @db.Date
  requiresConfirmation  Boolean
  onMiss                DutyOnMiss
  points                Int?
  status                DutyStatus          @default(ACTIVE)
  createdByMembershipId String              @db.Uuid
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  society      Society                     @relation(fields: [societyId], references: [id], onDelete: Cascade)
  participants ResponsibilityParticipant[]
  assignments  ResponsibilityAssignment[]

  @@index([societyId, status])
}

model ResponsibilityParticipant {
  id               String  @id @default(uuid(7)) @db.Uuid
  societyId        String  @db.Uuid
  responsibilityId String  @db.Uuid
  position         Int
  flatId           String? @db.Uuid
  membershipId     String? @db.Uuid

  society        Society        @relation(fields: [societyId], references: [id], onDelete: Cascade)
  responsibility Responsibility @relation(fields: [responsibilityId], references: [id], onDelete: Cascade)

  @@unique([responsibilityId, position])
}

model ResponsibilityAssignment {
  id                      String           @id @default(uuid(7)) @db.Uuid
  societyId               String           @db.Uuid
  responsibilityId        String           @db.Uuid
  periodIndex             Int
  periodStart             DateTime         @db.Date
  periodEnd               DateTime         @db.Date
  flatId                  String?          @db.Uuid
  membershipId            String?          @db.Uuid
  status                  AssignmentStatus @default(UPCOMING)
  confirmedAt             DateTime?
  confirmedByMembershipId String?          @db.Uuid
  overrideNote            String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  society        Society        @relation(fields: [societyId], references: [id], onDelete: Cascade)
  responsibility Responsibility @relation(fields: [responsibilityId], references: [id], onDelete: Cascade)

  @@unique([responsibilityId, periodIndex])
  @@index([societyId, status, periodEnd])
}

model Task {
  id                     String     @id @default(uuid(7)) @db.Uuid
  societyId              String     @db.Uuid
  title                  String
  description            String?
  points                 Int        @default(0)
  dueOn                  DateTime?  @db.Date
  assigneeMembershipId   String?    @db.Uuid
  status                 TaskStatus
  submissionNote         String?
  submittedAt            DateTime?
  completedAt            DateTime?
  verifiedByMembershipId String?    @db.Uuid
  createdByMembershipId  String     @db.Uuid
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  society Society      @relation(fields: [societyId], references: [id], onDelete: Cascade)
  events  TaskEvent[]
  proofs  StoredFile[]

  @@index([societyId, status])
  @@index([assigneeMembershipId, status])
}

model TaskEvent {
  id             String        @id @default(uuid(7)) @db.Uuid
  societyId      String        @db.Uuid
  taskId         String        @db.Uuid
  kind           TaskEventKind
  note           String?
  byMembershipId String        @db.Uuid
  createdAt      DateTime      @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt(sort: Desc)])
}

/// Append-only. A member's points = the sum of their rows.
model PointsLedger {
  id                    String       @id @default(uuid(7)) @db.Uuid
  societyId             String       @db.Uuid
  membershipId          String       @db.Uuid
  delta                 Int
  reason                PointsReason
  label                 String
  refType               String?
  refId                 String?      @db.Uuid
  financialYear         String
  createdByMembershipId String?      @db.Uuid
  createdAt             DateTime     @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@index([societyId, financialYear, membershipId])
  @@index([membershipId, createdAt(sort: Desc)])
}

// ---------- notifications (user owned) ----------
model Notification {
  id        String               @id @default(uuid(7)) @db.Uuid
  userId    String               @db.Uuid
  societyId String?              @db.Uuid
  category  NotificationCategory
  title     String
  body      String
  data      Json                 @default("{}")
  readAt    DateTime?
  createdAt DateTime             @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}

model NotificationDelivery {
  id             String          @id @default(uuid(7)) @db.Uuid
  notificationId String          @db.Uuid
  channel        DeliveryChannel
  status         DeliveryStatus  @default(PENDING)
  attempts       Int             @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime        @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model NotificationPreference {
  userId      String               @db.Uuid
  societyId   String               @db.Uuid
  category    NotificationCategory
  pushEnabled Boolean              @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, societyId, category])
}

// ---------- audit (append only) ----------
model AuditLog {
  id                String   @id @default(uuid(7)) @db.Uuid
  societyId         String?  @db.Uuid
  actorUserId       String?  @db.Uuid
  actorMembershipId String?  @db.Uuid
  action            String
  entityType        String
  entityId          String?
  before            Json?
  after             Json?
  requestId         String?
  ip                String?
  createdAt         DateTime @default(now())

  @@index([societyId, createdAt(sort: Desc)])
}

/// A photo in the file store (disk or an S3 bucket, see FileStore). Served through signed urls.
model StoredFile {
  id                String    @id @default(uuid(7)) @db.Uuid
  /// Null only for profile photos, which belong to the person, not to a society.
  societyId         String?   @db.Uuid
  ownerMembershipId String?   @db.Uuid
  kind              FileKind
  mime              String
  sizeBytes         Int
  storageKey        String    @unique
  /// Set once something uses the file. Unused files are removed after a day.
  attachedAt        DateTime?
  expenseId         String?   @db.Uuid
  paymentId         String?   @db.Uuid
  taskId            String?   @db.Uuid
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())

  society       Society?       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  expense       Expense?       @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  payment       Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  listingImages ListingImage[]
  avatarOf      User?          @relation("UserAvatar")
  logoOf        Society?       @relation("SocietyLogo")

  @@index([societyId, attachedAt])
  @@index([expenseId])
  @@index([paymentId])
  @@index([taskId])
}

model Listing {
  id                   String            @id @default(uuid(7)) @db.Uuid
  societyId            String            @db.Uuid
  sellerMembershipId   String            @db.Uuid
  kind                 ListingKind
  title                String
  description          String?
  priceType            PriceType
  pricePaise           Int?
  unit                 String?
  diet                 Diet?
  /// null = no limit. Goes down when the seller accepts an order.
  quantityAvailable    Int?
  readyAt              DateTime?
  orderBy              DateTime?
  fulfilment           Fulfilment        @default(PICKUP)
  condition            ItemCondition?
  visibility           ListingVisibility @default(SOCIETY)
  showPhoneAfterAccept Boolean           @default(false)
  status               ListingStatus     @default(ACTIVE)
  hiddenReason         String?
  ratingSum            Int               @default(0)
  ratingCount          Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  society Society         @relation(fields: [societyId], references: [id], onDelete: Cascade)
  images  ListingImage[]
  orders  MarketOrder[]
  reviews ListingReview[]
  reports ListingReport[]

  @@index([societyId, status, createdAt(sort: Desc)])
  @@index([sellerMembershipId, status])
}

model ListingImage {
  listingId String @db.Uuid
  fileId    String @db.Uuid
  societyId String @db.Uuid
  sortOrder Int

  society Society    @relation(fields: [societyId], references: [id], onDelete: Cascade)
  listing Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  file    StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([listingId, fileId])
}

model MarketOrder {
  id                 String      @id @default(uuid(7)) @db.Uuid
  societyId          String      @db.Uuid
  listingId          String      @db.Uuid
  buyerMembershipId  String      @db.Uuid
  sellerMembershipId String      @db.Uuid
  quantity           Int
  /// Unit price when the order was made. null when there was no price.
  unitPricePaise     Int?
  fulfilment         Fulfilment
  note               String?
  status             OrderStatus @default(REQUESTED)
  reason             String?
  acceptedAt         DateTime?
  readyAt            DateTime?
  closedAt           DateTime?
  buyerReadAt        DateTime    @default(now())
  sellerReadAt       DateTime    @default(now())
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  society  Society        @relation(fields: [societyId], references: [id], onDelete: Cascade)
  listing  Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  messages OrderMessage[]
  review   ListingReview?

  @@index([buyerMembershipId, status])
  @@index([sellerMembershipId, status])
  @@index([listingId, status])
}

model OrderMessage {
  id                 String   @id @default(uuid(7)) @db.Uuid
  societyId          String   @db.Uuid
  orderId            String   @db.Uuid
  senderMembershipId String   @db.Uuid
  body               String
  createdAt          DateTime @default(now())

  society Society     @relation(fields: [societyId], references: [id], onDelete: Cascade)
  order   MarketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model ListingReview {
  id                 String   @id @default(uuid(7)) @db.Uuid
  societyId          String   @db.Uuid
  listingId          String   @db.Uuid
  orderId            String   @unique @db.Uuid
  authorMembershipId String   @db.Uuid
  rating             Int
  text               String?
  createdAt          DateTime @default(now())

  society Society     @relation(fields: [societyId], references: [id], onDelete: Cascade)
  listing Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  order   MarketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt(sort: Desc)])
}

model ListingReport {
  id                   String       @id @default(uuid(7)) @db.Uuid
  societyId            String       @db.Uuid
  listingId            String       @db.Uuid
  reporterMembershipId String       @db.Uuid
  reason               String
  status               ReportStatus @default(OPEN)
  createdAt            DateTime     @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([societyId, status])
}
