{
  "name": "@movo/mobile",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output /tmp/movo-android.bundle --assets-dest /tmp/movo-android-assets",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "android:apk-release": "cd android && ./gradlew assembleRelease",
    "typecheck": "tsc -p tsconfig.json",
    "fonts:link": "react-native-asset",
    "pods": "cd ios && bundle exec pod install"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@movo/ar-native": "workspace:*",
    "@movo/contracts": "workspace:*",
    "@movo/design-system": "workspace:*",
    "@movo/i18n": "workspace:*",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/messaging": "26.4.0",
    "@react-navigation/bottom-tabs": "7.19.2",
    "@react-navigation/native": "7.4.1",
    "@react-navigation/native-stack": "7.19.2",
    "@tanstack/react-query": "5.104.0",
    "clsx": "2.1.1",
    "i18next": "26.4.2",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.15",
    "react-native": "0.87.1",
    "react-native-config": "1.7.2",
    "react-native-css-interop": "0.2.7",
    "react-native-image-picker": "8.2.1",
    "react-native-keychain": "10.0.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "5.10.0",
    "react-native-screens": "4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-export-namespace-from": "7.29.7",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@movo/config": "workspace:*",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/codegen": "0.87.1",
    "@react-native/gradle-plugin": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/react": "19.2.17",
    "react-native-asset": "2.3.0",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
