# Production settings. Copy to /opt/movo/.env.prod on the VM and fill in. Never commit .env.prod.
# Generate secrets with: openssl rand -hex 24   (hex keeps the database URL valid)

# ---- image and domain ----
# Image the api service runs. The deploy workflow pins the commit tag here.
API_IMAGE=ghcr.io/tejas96/movo-api:latest
# DNS A record pointing at the VM's public IP. Caddy gets the certificate for it.
API_DOMAIN=api.example.com
# Let's Encrypt expiry notices go here.
ACME_EMAIL=tejas96patil@gmail.com

# ---- database ----
POSTGRES_USER=movo
POSTGRES_PASSWORD=
POSTGRES_DB=movo

# ---- api (same names as apps/api/.env.example) ----
# at least 32 characters: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
APP_BASE_URL=movo://
# Resend for password reset emails. Empty = the link is only logged.
RESEND_API_KEY=
EMAIL_FROM=MOVO <no-reply@example.com>
# First platform admin, created by the seed command (see docs/08-release-and-ops.md).
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# Firebase service account JSON on one line, in single quotes. Empty = push is logged, not sent.
FIREBASE_SERVICE_ACCOUNT_JSON=
LOG_LEVEL=info
MIN_SUPPORTED_APP_VERSION=0.1.0
LATEST_APP_VERSION=0.1.0
SUPPORT_EMAIL=tejas96patil@gmail.com
PRIVACY_POLICY_URL=https://tejas96.github.io/movo/privacy.html

# ---- backups ----
# Daily run time in Asia/Kolkata.
BACKUP_AT=02:30
KEEP_DAILY=14
KEEP_MONTHLY=6
# Where dumps land on the VM.
BACKUP_HOST_DIR=./backups
# healthchecks.io ping URL. Empty = no ping.
BACKUP_HEARTBEAT_URL=
# Off-site copy. Empty = local only. For Cloudflare R2: r2:<bucket-name>
RCLONE_REMOTE=
RCLONE_S3_PROVIDER=Cloudflare
RCLONE_S3_ACCESS_KEY_ID=
RCLONE_S3_SECRET_ACCESS_KEY=
# R2: https://<account-id>.r2.cloudflarestorage.com
RCLONE_S3_ENDPOINT=
