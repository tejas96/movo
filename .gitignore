# dependencies
node_modules/

# build output
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

# env and secrets
.env
.env.*
!.env.example
!.env.prod.example
!apps/api/.env.test
*.pem
*.p8
*.keystore
!debug.keystore
# google-services.json / GoogleService-Info.plist are app config, not secrets: commit them.
# The Firebase service account key IS a secret: never commit it.
firebase-service-account*.json
*-firebase-adminsdk-*.json

# generated design preview (regenerate with: pnpm design:preview)
packages/design-system/preview/dist/

# logs and OS files
*.log
.DS_Store

# editors
.idea/
.vscode/*
!.vscode/extensions.json

# generated Prisma client (run: pnpm --filter @movo/api db:generate)
apps/api/src/generated/

# production backups when the prod compose is run from infra/ locally
infra/backups/

# uploaded files (FILES_DIR)
apps/api/data/

# Private notes and credentials (MOVO-VAULT.md). Never commit, never copy into an image.
.private/
