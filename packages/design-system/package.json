{
  "name": "@movo/design-system",
  "version": "0.0.1",
  "private": true,
  "description": "MOVO design tokens, Tailwind preset, Poppins fonts, Iconsax icon data, and React Native primitives.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./tailwind-preset": "./tailwind.preset.js",
    "./fonts/*": "./assets/fonts/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "icons": "node scripts/build-icons.mjs",
    "fonts": "node scripts/sync-fonts.mjs",
    "preview": "node scripts/build-icons.mjs && node scripts/build-preview.mjs",
    "check:preset": "node scripts/check-preset.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "jiti": "2.7.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@expo-google-fonts/poppins": "0.4.1",
    "@movo/config": "workspace:*",
    "@react-navigation/bottom-tabs": "7.19.2",
    "@react-navigation/native": "7.4.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "iconsax": "0.1.1",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "5.10.0",
    "react-native-svg": "15.15.5",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "nativewind": ">=4.1",
    "react": ">=19",
    "react-native": ">=0.80",
    "react-native-safe-area-context": ">=5",
    "react-native-svg": ">=15",
    "@react-navigation/bottom-tabs": ">=7"
  }
}
